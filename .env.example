SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=4000

# Stripe billing (server-side only, never prefix with VITE_) -- fill in
# from the Stripe dashboard. See the Stripe dashboard setup checklist
# handed off alongside this file for exactly where each value comes from.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# One Price ID per paid tier -- Free has no price ID, it never touches Stripe.
STRIPE_PRICE_ID_PRO=your-stripe-price-id-for-pro
STRIPE_PRICE_ID_FIRM=your-stripe-price-id-for-firm
