VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Client-side (safe to expose -- this is Stripe's publishable key, not the secret one)
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Server-side only (used by client/api/*.js Vercel functions) - do NOT prefix with VITE_,
# or these get bundled into the client and exposed in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing (server-side only) -- fill in from the Stripe dashboard.
# See the Stripe dashboard setup checklist handed off alongside this file
# for exactly where each value comes from.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# One Price ID per paid tier -- Free has no price ID, it never touches Stripe.
STRIPE_PRICE_ID_PRO=your-stripe-price-id-for-pro
STRIPE_PRICE_ID_FIRM=your-stripe-price-id-for-firm
